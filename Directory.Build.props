<Project>

  <!--
    Applies to every project in the repository (src, tests, benchmarks, samples).
    Package-specific settings live in src/Directory.Build.props.
  -->

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningLevel>9999</WarningLevel>
  </PropertyGroup>

  <PropertyGroup>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!--
      Code style (IDE diagnostics) is verified by the `format` check in CI
      rather than enforced at build time, so that whitespace never blocks a build.
    -->
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <ArtifactsPath>$(MSBuildThisFileDirectory)artifacts</ArtifactsPath>
  </PropertyGroup>

  <PropertyGroup>
    <RepositoryUrl>https://github.com/brunominervino/Theon</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Product>Theon</Product>
    <Authors>Theon Contributors</Authors>
    <Copyright>Copyright (c) Theon Contributors</Copyright>
  </PropertyGroup>

</Project>
