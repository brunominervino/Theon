<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>Theon.Localization</RootNamespace>
    <AssemblyName>Theon.Localization.It</AssemblyName>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Theon.Localization.It</PackageId>
    <Description>Italian validation messages for Theon.</Description>
    <PackageTags>schema;validation;localization;italian;it</PackageTags>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Raised with each release, alongside the other packages. -->
    <PackageValidationBaselineVersion>0.1.0-preview.7</PackageValidationBaselineVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Theon/Theon.csproj" />
  </ItemGroup>

</Project>
