<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>Theon.AspNetCore</RootNamespace>
    <AssemblyName>Theon.AspNetCore</AssemblyName>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Theon.AspNetCore</PackageId>
    <Description>ASP.NET Core integration for Theon: validate request bodies at the endpoint and answer with ProblemDetails.</Description>
    <PackageTags>schema;validation;aspnetcore;minimal-api;problemdetails</PackageTags>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      The first release of this package has no predecessor to compare against. Point it at the
      previous version once one exists, the same way the core package does.
    -->
    <PackageValidationBaselineVersion></PackageValidationBaselineVersion>
  </PropertyGroup>

  <ItemGroup>
    <!--
      A framework reference, not a package reference: this consumes the shared ASP.NET Core
      framework the host already has, so the package itself still declares no dependencies. An
      application installing it is one that is already ASP.NET Core.
    -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Theon/Theon.csproj" />
  </ItemGroup>

</Project>
