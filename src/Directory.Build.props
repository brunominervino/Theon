<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- Shipping libraries: packable, documented, AOT-clean, API-stable. -->

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      The public API is not settled, and 1.0.0 is a promise that it is. Packing produces a
      prerelease by default; a real release is cut by clearing the suffix explicitly:
        dotnet pack src/Theon/Theon.csproj -c Release -p:VersionSuffix=
      Raise VersionPrefix here, in its own commit, when cutting a version.
    -->
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix Condition="'$(VersionSuffix)' == ''">preview.9</VersionSuffix>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      Turns on the trim, AOT and single-file analyzers. Any reflection that cannot be
      statically proven safe becomes a build error, which is exactly what we want for
      a library that promises Native AOT support.
    -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <PropertyGroup>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/brunominervino/Theon</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>schema;validation;parsing;fluent;aot</PackageTags>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      Checks the package for internal consistency across target frameworks, and, once
      PackageValidationBaselineVersion names a published version, fails the build on a breaking
      change against it. There is no published version yet, so only the former is active today.
    -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <!--
      Compares the public API against this published version and fails the build on anything that
      breaks binary compatibility with it. Raise it to the newest release as part of releasing, so
      each version is checked against the one before it rather than against an ever more distant
      ancestor.
    -->
    <PackageValidationBaselineVersion>0.1.0-preview.8</PackageValidationBaselineVersion>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <Import Project="$(MSBuildThisFileDirectory)../eng/TrimGeneratedDocs.targets" />

</Project>
